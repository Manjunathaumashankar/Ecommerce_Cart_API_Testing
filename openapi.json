{
  "openapi": "3.0.3",
  "info": {
    "title": "E-Commerce Shopping Cart REST API",
    "description": "Production-grade RESTful API for managing shopping cart operations, product catalog, discount coupons, checkout, and orders.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5000",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Health check & API status",
        "responses": {
          "200": { "description": "API status confirmation" }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "List all products in catalog",
        "responses": {
          "200": { "description": "Array of products" }
        }
      }
    },
    "/products/{product_id}": {
      "get": {
        "summary": "Get product details by ID",
        "parameters": [
          { "name": "product_id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Product details" },
          "404": { "description": "Product not found" }
        }
      }
    },
    "/cart": {
      "get": {
        "summary": "View items in shopping cart, applied coupon, discount amount, and calculated totals",
        "responses": {
          "200": { "description": "Shopping cart summary with line items, applied coupon, discount, and grand total" }
        }
      },
      "post": {
        "summary": "Add product to shopping cart",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["product_id", "quantity"],
                "properties": {
                  "product_id": { "type": "integer", "example": 1 },
                  "quantity": { "type": "integer", "example": 2 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Product successfully added to cart" },
          "400": { "description": "Invalid input or insufficient stock" },
          "404": { "description": "Product not found" }
        }
      },
      "delete": {
        "summary": "Clear entire shopping cart and reset active coupon",
        "responses": {
          "200": { "description": "Cart cleared successfully" }
        }
      }
    },
    "/cart/{product_id}": {
      "put": {
        "summary": "Update product quantity in cart",
        "parameters": [
          { "name": "product_id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["quantity"],
                "properties": {
                  "quantity": { "type": "integer", "example": 3 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Cart quantity updated successfully" },
          "400": { "description": "Invalid quantity or insufficient stock" },
          "404": { "description": "Cart item not found" }
        }
      },
      "delete": {
        "summary": "Remove single product from cart",
        "parameters": [
          { "name": "product_id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Product removed from cart successfully" },
          "404": { "description": "Cart item not found" }
        }
      }
    },
    "/coupons": {
      "get": {
        "summary": "List available discount coupons",
        "responses": {
          "200": { "description": "Array of coupon objects" }
        }
      }
    },
    "/cart/apply-coupon": {
      "post": {
        "summary": "Apply a discount coupon to the active shopping cart",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code"],
                "properties": {
                  "code": { "type": "string", "example": "SAVE10" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Coupon applied successfully" },
          "400": { "description": "Empty cart, expired coupon, or minimum order value not met" },
          "404": { "description": "Coupon code not found" }
        }
      }
    },
    "/cart/coupon": {
      "delete": {
        "summary": "Remove applied discount coupon from shopping cart",
        "responses": {
          "200": { "description": "Coupon removed successfully" }
        }
      }
    },
    "/cart/checkout": {
      "post": {
        "summary": "Checkout shopping cart, apply discount, deduct stock, and generate confirmed order",
        "responses": {
          "201": { "description": "Order placed successfully, inventory deducted, cart cleared" },
          "400": { "description": "Empty cart or insufficient stock" }
        }
      }
    },
    "/orders": {
      "get": {
        "summary": "View all completed orders",
        "responses": {
          "200": { "description": "List of orders" }
        }
      }
    },
    "/orders/{order_id}": {
      "get": {
        "summary": "View specific order details",
        "parameters": [
          { "name": "order_id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Order details with line items" },
          "404": { "description": "Order not found" }
        }
      }
    },
    "/reset": {
      "post": {
        "summary": "Reset database to default initial state (for automated test isolation)",
        "responses": {
          "200": { "description": "Database reset confirmation" }
        }
      }
    }
  }
}
